istol":null,"maps":4,"pistol_n":[0,0]}],"Ancient":[{"ct":null,"t":null,"pistol":null,"maps":3,"pistol_n":[0,0]},{"ct":null,"t":null,"pistol":null,"maps":1,"pistol_n":[0,0]}],"Anubis":[null,{"ct":null,"t":null,"pistol":null,"maps":1,"pistol_n":[0,0]}]},"total":[{"ct":null,"t":null,"pistol":null,"maps":18,"pistol_n":[0,0]},{"ct":null,"t":null,"pistol":null,"maps":17,"pistol_n":[0,0]}]},"news":{"updated":"2026-11-02T00:47:56Z","days":7,"items":[{"key":"df1e5881a71800f5","title":"M0NESY: «Я не вижу, чтобы у kyousuke были какие-то проблемы с формой вне официальных матчей»","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":"Снайпер команды Team Falcons Илья m0NESY высказался о форме Максима kyousuke Лукина, отметив, что он не видит проблем у игрока вне официальных матчей. Команда начнёт своё выступление на турнире IEM Beijing 2026 против Na'Vi 2 ноября в 12:30 по московскому времени.","quotes":[{"ru":"я не вижу, чтобы у kyousuke были какие-то проблемы с формой вне официальных матчей","who":"m0NESY"}],"image":"https://images.cybersport.ru/images/og-jpg/plain/8b/8b7959fe-a566-484e-803c-2350d1fd1f61.jpg","kind":"новость","about":["m0NESY","kyousuke"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/m0nesy-ya-ne-vizhu-chtoby-u-kyousuke-byli-kakiye-to-problemy-s-formoi-vne","date":"2026-11-01T15:50:00Z","also":[{"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/m0nesy-o-iem-beijing-na-yetom-turnire-net-ni-spirit-ni-vitality-no-yeto-ne","title":"M0NESY о IEM Beijing: «На этом турнире нет ни Spirit, ни Vitality. Но это не значит, что ивент стал легче»"},{"source":"HLTV","url":"https://www.hltv.org/news/45873/m0nesy-maybe-sometimes-kyousuke-overthinks-and-he-thinks-that-hes-forced-to-say-something-to-always-do-something","title":"m0NESY: «Может быть, иногда kyousuke задумывается и думает, что он вынужден что-то сказать, всегда что-то делать»"}]},{"key":"48657b1e7f0942d9","title":"Natus Vincere отказались от выступления в плей-офф HyperX Retake Season 13","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":"Украинская команда NaVi снялась с турнира HyperX Retake Season 13 после технического поражения в четвертьфинале от WhiteBIT Academy. Причиной стало желание сосредоточиться на подготовке к IEM Beijing 2026, стартующему 2 ноября. Китайский коллектив TYLOO поступил аналогично. Турнир проходил в Португалии с 30 октября по 1 ноября и включал призовой фонд в размере $13 тысяч.","quotes":[],"image":"https://images.cybersport.ru/images/og-jpg/plain/f4/f4539730-194e-40f5-a02d-d74926ed9556.jpg","kind":"новость","about":["Natus Vincere"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/natus-vincere-otkazalis-ot-vystupleniya-v-plei-off-hyperx-retake-season-13","date":"2026-10-31T07:00:00Z","also":[]},{"key":"eb7446e58a9674cf","title":"NAVI по CS2 одержали победу в Португалии. Что с мейджором для клуба?","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":null,"quotes":[],"image":null,"kind":"новость","about":["Natus Vincere"],"source":"Sport.ua","url":"https://news.google.?oc=5","date":"2026-10-30T12:26:00Z","also":[]},{"key":"48103a64b143fa09","title":"Pimp предложил Team Spirit продать donk за $10 млн и купить m0NESY и kyousuke","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":null,"quotes":[],"image":"https://images.cybersport.ru/images/og-jpg/plain/f1/f1bb012f-1338-4355-970f-10db1dcaa40c.jpg","kind":"новость","about":["m0NESY","kyousuke"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/pimp-predlozhil-team-spirit-prodat-donk-za-10-mln-i-kupit-m0nesy-i-kyousuke","date":"2026-10-30T09:23:00Z","also":[]},{"key":"e3866092ed35e526","title":"Zeus об игре NAVI на Dust2 против Vitality: «Очень странно, что B1ad3 не понимает, как играть за атаку»","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":"Даниил Zeus Тесленко выразил разочарование игрой команды Natus Vincere на карте Dust2 во время матча против Vitality на турнире PGL Masters Bucharest 2026. По его мнению, Андрей B1ad3 неправильно понимал стратегию атаки.","quotes":[{"ru":"Очень странно, что B1ad3 не понимает, как играть за атаку","who":"Zeus"}],"image":"https://images.cybersport.ru/images/og-jpg/plain/3b/3bad0f8e-df5d-4617-be88-f718da4aa0ec.jpg","kind":"новость","about":["Natus Vincere"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/zeus-ob-igre-navi-na-dust2-protiv-vitality-ochen-stranno-chto-b1ad3-ne-ponimayet","date":"2026-10-29T15:41:00Z","also":[]},{"key":"b26ac5157e95d778","title":"Pimp после выхода NAVI в плей-офф PGL Masters Bucharest 2026: «Команда официально остановила кровотечение»","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":"Аналитик Pimp прокомментировал выход команды Natus Vincere в плей-офф турнира PGL Masters Bucharest 2026, отметив, что команда остановила своё поражение. В группе NaVi одержали победу над Team Spirit со счётом 3:2 и теперь сыграют против Team Vitality. Турнир проходит в Румынии с 24 по 31 октября, призовой фонд составляет 1,25 миллиона долларов.","quotes":[],"image":"https://images.cybersport.ru/images/og-jpg/plain/38/389cba87-180f-456f-b80f-71ced5a361fd.jpg","kind":"новость","about":["Natus Vincere"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/pimp-posle-vykhoda-navi-v-plei-off-pgl-masters-bucharest-2026-komanda-ofitsialno","date":"2026-10-29T07:48:00Z","also":[{"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/team-vitality-ili-natus-vincere-kto-prodolzhit-vystupleniye-na-pgl-masters","title":"Team Vitality или Natus Vincere — кто продолжит выступление на PGL Masters Bucharest 2026?"},{"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/team-vitality-vyigrala-u-natus-vincere-v-plei-off-pgl-masters-bucharest-2026","title":"Team Vitality выиграла у Natus Vincere в плей-офф PGL Masters Bucharest 2026"},{"source":"irbis.spb.ru","url":"https://news.google.com/rss/articles/CBMiugFBVV95cUxQcjFPTDRZNFhfVnhsRW9MbzdwZEs0UVNtYnpnWEh3RDlRRnFQSjhsVmQyanF5eU4zZ0J1ZFZUSGFEZ3IwSHA1UDN5UUdvcFVVUFZZQmZBRWFiTXY1WGEzYmRObzluQUF6Yk1UaVZKcjlDY3Z0S1ljdk5ZSUFUeDFBQjYtZHJaclEzTXJkbEJsZHljcW5DRmVlOXF4VERTa0NXYXhvUEVORzNoa0ZrVjlMQUwzcF9ZM043Nmc?oc=5","title":"NAVI обыграла Team Spirit и вышла в плей-офф PGL Masters Bucharest 2026 по CS 2"},{"source":"Natus Vincere","url":"https://news.google.com/rss/articles/CBMieEFVX3lxTFBWX0ZoNU9pX3ZOaC1zT01IcFlCQWJ5QnI1djg3cmhpdGw5dnM0c3QwMTROVTRhRzA0YWhKZjhnLTJWNW5xcEhCSXRzano5LXVtbmY5STlnS3FrdVZTOUF3c2U4MExwSGwyaUMzV0lNbGtOTEJSdE14dA?oc=5","title":"Матч Vitality vs NAVI PGL Masters Bucharest 2026 29 октября 2026 — 12:22 - Counter-Strike 2 - Natus Vincere"}]},{"key":"f0b31770e0e068ea","title":"Sh1ro после поражения от NAVI: «Надо лучше играть в CS — всё, что можно сказать нам как команде»","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":"Дмитрий sh1ro Соколов, снайпер команды Team Spirit, прокомментировал поражение своей команды от Natus Vincere на турнире PGL Masters Bucharest 2026. После проигранного матча команда заняла 9-11 места и покинула соревнование, тогда как NAVI вышли в плей-офф.","quotes":[{"ru":"«Надо лучше играть в CS — всё, что можно сказать нам как команде»","who":"sh1ro"}],"image":"https://images.cybersport.ru/images/og-jpg/plain/03/036adec3-8855-47c0-ae8e-97ec6ba8203d.jpg","kind":"новость","about":["Natus Vincere"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/sh1ro-posle-porazheniya-ot-navi-nado-luchshe-igrat-v-cs-vse-chto-mozhno-skazat","date":"2026-10-28T20:59:00Z","also":[]},{"key":"f4e9fee58a53fbce","title":"Aleksib назвал главной проблемой NAVI долгий совместный состав","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":null,"quotes":[],"image":null,"kind":"трансфер","about":["Natus Vincere","Aleksib"],"source":"StavkiPrognozy.ru","url":"https://news.google.com/rss/articles/CBMiqwFBVV95cUxQenkyVVgtSVZMTG1ZcVRYZFZOYi12UGZfLWdrbS1pQkFha2U3b3ZrSjRBbEVWa1M4ZkVVY0VlcXlZTkprYVVMcVZDTDZLNHJOdmxYY3BfZHZGb2tyNy15bXlBUjVLQXVCS1V4ZmF6Ti1FRHh0eEx4VUt3WGVTZ1JiYzVNNDE4eXg4TjE0WlRwTG50V1pwMzlHbVJzOFNtT3hHS1k0RjRvM2Y4dlE?oc=5","date":"2026-10-28T19:51:51Z","also":[]},{"key":"ed9cdf81fe3f7527","title":"Aleksib о NAVI: «Думаю, главная проблема в том, что мы уже очень давно играем вместе»","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":"Капитан NAVI Aleksib прокомментировал проблемы коллектива после неудачных выступлений на нескольких турнирах, включая IEM Cologne Major 2026. Он отметил, что коллектив испытывает сложности из-за долгого совместного выступления, пройдя четыре крупных соревнования без успешного прохождения группового этапа или вылета в первом раунде плей-офф. Сейчас NAVI участвуют в PGL Masters Bucharest 2026 и готовятся к встрече с Team Vitality.","quotes":[{"ru":"Думаю, главная проблема в том, что мы уже очень давно играем вместе","who":"Aleksib"},{"ru":"NAVI прошли групповую стадию со счётом 3:2 и теперь сыграют с Team Vitality в первом раунде плей-офф","who":""}],"image":"https://images.cybersport.ru/images/og-jpg/plain/f4/f4acc9cc-9a58-4a42-9fd0-132f1537df3f.jpg","kind":"новость","about":["Natus Vincere","Aleksib"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/aleksib-o-navi-dumayu-glavnaya-problema-v-tom-chto-my-uzhe-ochen-davno-igrayem","date":"2026-10-28T19:50:00Z","also":[]},{"key":"cf4fc8bde99165d1","title":"Hally о матче с NAVI: «Если состояние будет нормальным, то я вернусь за спины ребятам»","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":"Сергей hally Шаваев, тренер команды Team Spirit, рассказал, почему пропустил игру против MOUZ на турнире PGL Masters Bucharest 2026. Он заявил, что вернется в следующем матче против Natus Vincere, если его физическое состояние позволит это сделать. В игре с MOUZ вместо него временно выступал Дмитрий S0tF1k Форостянко.","quotes":[{"ru":"«Если состояние будет нормальным, то я вернусь за спины ребятам»","who":"hally"}],"image":"https://images.cybersport.ru/images/og-jpg/plain/f3/f371e059-157c-4a64-b8b6-9a3532d0e116.jpg","kind":"новость","about":["Natus Vincere"],"source":"Cybersport.ru","url":"https://www.cybersport.ru/tags/cs2/hally-o-matche-s-navi-yesli-sostoyaniye-budet-normalnym-to-ya-vernus-za-spiny","date":"2026-10-28T15:50:00Z","also":[]},{"key":"7bb941bcdca04b47","title":"FaZe Clan’s NiKo apologizes for “embarrassing” performance at Berlin Major","title_ru":"NiKo из FaZe Clan приносит извинения за «неловкое» выступление на Major в Берлине","lang":"en","lang_ru":"английского","summary_ru":null,"quotes":[],"image":null,"kind":"новость","about":["NiKo"],"source":"Dexerto","url":"https://news.google.com/rss/articles/CBMiowFBVV95cUxOSzI2eXAxcW5hZm5HWHdSekcweG1jUW1Wek1ILXBjbDdLbUlvQy16RlpxV1RDdENENHN6YlJobU1RR3NEb3B5a0VBaXN1dEtYdFJURmk4T2JoWC1rWmFuQkd6RFBwd21lU3NXTFYtX1ZFV0hnNmtOUVZHYkZWRzFBQ1RJWC1LaDZGSTd2Uko3NUEwYlE3Y2laWHYzOXQyazVfZzhN?oc=5","date":"2026-10-28T07:00:00Z","also":[]},{"key":"c6df5cb3cce0f6c0","title":"Karrigan заявил, что хочет стать величайшим капитаном в истории CS","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":null,"quotes":[],"image":null,"kind":"интервью","about":["karrigan"],"source":"Esports.ru","url":"https://news.google.com/rss/articles/CBMigwFBVV95cUxOemFNS1Z2LXAtWVFvVTltTzRkSnZXU211WEE5aldTNEpEYXptMHRORHRkeHdYel9ORHZnWjBWc0VrUmtnMWloWExpenRaSWpJWkQ0US1VX1d0RlhvMVhvV0hnUUhMT3ZFVU9DdFhKeFdPbFNHd3Z1TU13UGJNbUI1VHp6TQ?oc=5","date":"2026-10-27T18:09:36Z","also":[]},{"key":"400c4f4914bb8e7e","title":"Aleksib признал заслуженной победу BETBOOM TEAM над NAVI на PGL Masters","title_ru":null,"lang":"ru","lang_ru":null,"summary_ru":null,"quotes":[],"image":null,"kind":"новость","about":["Natus Vincere","Aleksib"],"source":"StavkiPrognozy.ru","url":"https://news.google.com/rss/articles/CBMiuAFBVV95cUxPU3BVX2xJZ0Vqc1BDenFNdXJZNHFOS3dWZHNXcTJoT3dzSFhySUFTUlozUzFQRTZPRmdONUE4bWlleWFaZUtfaExNcjNHRG9fcDI4d2o5M1pKOUJpZVc5YzlLVWNRcFhwVUZFbG1KcHNuLU1vMXcwbVA4RWg3S2lfUEZMTG13SFJSQUJva2JVYU5POERjX0NFaVZ4SVItRDN2b0kxTFF2d09LNlZTRTJHNjhHSHZGbUxV?oc=5","date